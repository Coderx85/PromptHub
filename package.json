    "better-auth": "^1.5.5",
    "daisyui": "^5.5.19",
    "husky": "^9.1.7",
    "mongodb": "^7.1.0",
    "mongoose": "^9.3.1",
    "next": "16.1.7",
    "next-auth": "^4.24.13",
    "postcss": "8.5.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
